{
  "name": "canvas-lms-mcp-remote",
  "version": "1.4.1",
  "description": "Self-hosted Canvas LMS MCP server for every device: 242 student tools over Streamable HTTP with an OAuth login, a status page, phone alerts, an ngrok or Cloudflare tunnel and multi-computer failover.",
  "mcpName": "io.github.Fireiscoolsolo/canvas-lms-mcp-server",
  "type": "module",
  "main": "index.js",
  "bin": {
    "canvas-lms-mcp-remote": "cli.js"
  },
  "files": [
    "cli.js",
    "index.js",
    "supervisor.js",
    "oauth-provider.js",
    "alerts.js",
    "status-page.js",
    "file-share.js",
    "totp.js",
    "log-file.js",
    "service.js",
    "doctor.js",
    "startup-check.js",
    "env-file.js",
    "core/",
    "Dockerfile",
    "docker-compose.yml",
    ".env.example",
    "README.md",
    "MULTI_DEVICE.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node supervisor.js",
    "serve": "node index.js",
    "test": "node --test"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "canvas",
    "canvas-lms",
    "instructure",
    "lms",
    "students",
    "education",
    "oauth",
    "ngrok",
    "self-hosted",
    "ai-assistant",
    "cloudflare-tunnel",
    "docker",
    "claude",
    "chatgpt"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fireiscoolsolo/canvas-lms-mcp-server.git"
  },
  "homepage": "https://fireiscoolsolo.github.io/canvas-lms-mcp-server/",
  "bugs": {
    "url": "https://github.com/Fireiscoolsolo/canvas-lms-mcp-server/issues"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "jszip": "^3.10.2",
    "unpdf": "~1.8.1",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=18"
  }
}

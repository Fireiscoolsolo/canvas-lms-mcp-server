# Copy this file to .env and fill in your own values. Never share or commit .env.

# --- Required ---
# Canvas > Account > Settings > Approved Integrations > + New Access Token
CANVAS_API_TOKEN=paste_your_canvas_token_here
# Your school's Canvas address (with or without /api/v1)
CANVAS_BASE_URL=https://yourschool.instructure.com

# --- Remote access (needed for web/phone access and supervisor.js) ---
# Your static ngrok domain, e.g. https://your-name.ngrok-free.dev
CANVAS_MCP_PUBLIC_URL=https://your-domain.ngrok-free.dev
# Password you type once per device when connecting. Use a long random string.
# The server won't start until you change this.
CANVAS_MCP_PASSWORD=choose_a_long_random_password
# Shared secret between machines running supervisor.js. Must match on every machine.
# At least 16 random characters. The server won't start until you change this.
CANVAS_MCP_CLUSTER_SECRET=generate_a_long_random_secret

# --- Optional ---
# CANVAS_ALLOW_WRITES=true          # false = read-only (removes state-changing tools)
# CANVAS_PROFILE=full               # core = smaller curated tool set
# CANVAS_TOOLS=grades,planner       # only these tool groups or tool names
# CANVAS_DISABLE_TOOLS=inbox        # leave out these tool groups or tool names
# CANVAS_CACHE_TTL=60
# CANVAS_TIMEZONE=America/New_York
# CANVAS_DOWNLOAD_DIR=./canvas-downloads
# CANVAS_IP_FAMILY=4                # only IPv4 (or 6); worth trying if new connections time out
# CANVAS_MCP_HOST=127.0.0.1
# CANVAS_MCP_PORT=3939
# CANVAS_MCP_OAUTH_STORE_PATH=./oauth-store.json
# CANVAS_MCP_TOTP_SECRET=           # two-factor codes on the login page; set up with: canvas-lms-mcp-remote totp-setup

# --- Tunnel and failover (optional) ---
# CANVAS_MCP_TUNNEL=ngrok           # ngrok (default), cloudflared, or none if you route the address yourself
# CANVAS_MCP_NGROK_PATH=C:\path\to\ngrok.exe
# CANVAS_MCP_CLOUDFLARED_TOKEN=     # tunnel token from the Cloudflare dashboard, for CANVAS_MCP_TUNNEL=cloudflared
# CANVAS_MCP_FAILOVER_SECONDS=50    # how long the serving computer can be silent before another takes over
# NGROK_AUTHTOKEN=                  # only for docker-compose.yml

# --- Phone alerts (optional, see "Phone alerts" in the README) ---
# Channels: set any you like.
# CANVAS_ALERTS_NTFY_TOPIC=a-long-hard-to-guess-topic-name
# CANVAS_ALERTS_DISCORD_WEBHOOK=https://discord.com/api/webhooks/...
# CANVAS_ALERTS_TELEGRAM_TOKEN=123456:ABC...   # from @BotFather
# CANVAS_ALERTS_TELEGRAM_CHAT_ID=123456789
# CANVAS_ALERTS_SLACK_WEBHOOK=https://hooks.slack.com/services/...
# CANVAS_ALERTS_TEAMS_WEBHOOK=https://...       # a Teams "Workflows" incoming webhook
# CANVAS_ALERTS_PUSHOVER_TOKEN=
# CANVAS_ALERTS_PUSHOVER_USER=
# What to alert about (default: grades,announcements,due,token). Also: assignments, comments, inbox, grade_drop, security
# CANVAS_ALERTS=grades,announcements,due,token
# CANVAS_ALERTS_DUE_HOURS=24
# CANVAS_ALERTS_INTERVAL_MINUTES=15
# CANVAS_ALERTS_GRADE_BELOW=70       # for grade_drop
# CANVAS_ALERTS_DIGEST=07:30         # one summary a day at this time
# CANVAS_ALERTS_MODE=both            # instant, digest (only urgent alerts in between) or both
# CANVAS_ALERTS_QUIET=22:00-07:00    # hold non-urgent alerts during these hours
# CANVAS_ALERTS_COURSES=             # only these courses (IDs or part of the name), comma-separated
# CANVAS_ALERTS_SKIP_COURSES=        # never these courses
